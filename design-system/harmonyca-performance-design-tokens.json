{
  "$meta": {
    "name": "HArmonyCa Performance Design System",
    "version": "1.0.0",
    "author": "Edegar Junior",
    "source": "Identidade visual própria da marca",
    "language": "pt-BR",
    "themes": [
      "dark",
      "light"
    ],
    "defaultTheme": "dark",
    "note": "Cores derivadas das institucionais (violeta, azul, coral, navy e apoio). Nada deve sair desta paleta. Aplique tokens, nunca hex solto nos componentes."
  },
  "breakpoints": {
    "desktop": 1200,
    "tablet": 810,
    "phone": 390
  },
  "color": {
